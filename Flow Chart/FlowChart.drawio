        <mxCell id="v2_act_sleep" value="Enter low-power sleep mode&lt;div style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;(Disable Servo PWM pulses to save energy)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;arcSize=8;align=center;" vertex="1" parent="1">
