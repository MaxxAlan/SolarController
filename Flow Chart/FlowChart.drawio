  <diagram id="solar-tracker-v2-en" name="Solar Tracker V2 (English)">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Nodes -->
        <mxCell id="v2_start" value="Start (Power ON / Boot)" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="30" width="180" height="42" as="geometry" />
        </mxCell>

        <mxCell id="v2_init" value="System Initialization (Setup)&lt;div style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;(Configure GPIOs, 4 ADC Channels, Servo PWM)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;arcSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="100" width="340" height="48" as="geometry" />
        </mxCell>

        <mxCell id="v2_net" value="Connect Wi-Fi &amp;amp; Sync Firebase RTDB&lt;div style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;(Initialize Stream Listener for /controls from Cloud)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;arcSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="175" width="340" height="48" as="geometry" />
        </mxCell>

        <mxCell id="v2_q_net" value="Wi-Fi &amp;amp; Firebase&lt;div&gt;connected &amp;amp; ready?&lt;/div&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="385" y="250" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="v2_act_offline" value="Activate Offline Failsafe Mode&lt;div style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;(Autonomous local tracking, background reconnect)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;arcSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="370" width="270" height="52" as="geometry" />
        </mxCell>

        <mxCell id="v2_cmd_proc" value="Read Commands from Firebase RTDB&lt;div style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Node /controls: Mode (Auto/Manual), Target Angle&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;arcSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="370" width="300" height="52" as="geometry" />
        </mxCell>

        <mxCell id="v2_read_sens" value="Read and process sensor data&lt;div style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;(Moving-average digital filter for ADC signals)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=13;arcSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="335" y="460" width="290" height="50" as="geometry" />
        </mxCell>

        <mxCell id="v2_inp_ldr" value="4 Light Sensors data (LDRs)&lt;div style=&quot;font-size: 10px;&quot;&gt;(Top/Bottom, Left/Right)&lt;/div&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="465" width="220" height="42" as="geometry" />
        </mxCell>

        <mxCell id="v2_inp_bat" value="18650 Battery Voltage &amp;amp; Energy&lt;div style=&quot;font-size: 10px;&quot;&gt;(ADC Voltage Divider / TP4056)&lt;/div&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Segoe UI;fontSize=12;align=center;" vertex="1" parent="1">
